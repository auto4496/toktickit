// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ActionOperation {
  CREATED
  EDITED
  STARTED
  COMPLETED
  CANCELLED
}

model User {
  id                  String                @id @default(uuid())
  name                String
  email               String                @unique
  isActive            Boolean               @default(true)
  role                Role                  @default(REQUESTER)
  passwordHash        String
  mustChangePassword  Boolean               @default(true)
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  tickets             Ticket[]
  ticketCreateRequests TicketCreateRequest[]
  uploadedAttachments Attachment[]          @relation("AttachmentUploadedBy")
  removedAttachments  Attachment[]          @relation("AttachmentRemovedBy")
  ownedTickets        Ticket[]              @relation("TicketOwner")
  sessions            AuthSession[]
  publicComments      PublicComment[]
  internalNotes       InternalNote[]
  assignedActions     ActionTaken[]          @relation("ActionAssignee")
  createdActions      ActionTaken[]          @relation("ActionCreator")
  performedActions    ActionTaken[]          @relation("ActionPerformer")
  actionRevisions     ActionRevision[]
  actionCreateRequests ActionCreateRequest[]
}

model AuthSession {
  id           String   @id @default(uuid())
  tokenHash    String   @unique
  csrfToken    String
  userId       String
  userVersion  Int
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
}

model PublicComment {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id                String              @id @default(uuid())
  ticketNumber      String              @unique
  requesterId       String
  categoryId        Int
  relatedSystemId   Int
  summary           String
  requestedPriority Priority
  itPriority        Priority
  ownerId           String?
  version           Int                 @default(1)
  requesterResolvedAt DateTime?
  description       String
  currentStatus     TicketStatus        @default(NEW)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  requester         User                @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  owner             User?               @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category          Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem     RelatedSystem       @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  createRequest     TicketCreateRequest?
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]
  actionsTaken      ActionTaken[]

  @@index([currentStatus, updatedAt])
  @@index([ownerId, updatedAt])
  @@index([itPriority, updatedAt])
  @@index([requesterId, updatedAt])
  @@index([requesterId, currentStatus, updatedAt])
  @@index([requesterId, requestedPriority, updatedAt])
  @@index([requesterId, categoryId, updatedAt])
}

model ActionTaken {
  id               String           @id @default(uuid())
  ticketId         String
  assignedToId     String
  createdById      String
  performedById    String
  actionAt         DateTime
  description      String
  result           String           @default("")
  followUpRequired Boolean          @default(false)
  followUpNote     String           @default("")
  attachmentNotes  String           @default("")
  status           ActionStatus     @default(PLANNED)
  version          Int              @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt
  ticket           Ticket           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignedTo       User             @relation("ActionAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy        User             @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy      User             @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  revisions        ActionRevision[]
  createRequest    ActionCreateRequest?

  @@index([ticketId, actionAt, id])
  @@index([ticketId, status])
  @@index([assignedToId, status])
}

model ActionRevision {
  id        String          @id @default(uuid())
  actionId  String
  actorId   String
  operation ActionOperation
  snapshot  Json
  createdAt DateTime        @default(now())
  action    ActionTaken     @relation(fields: [actionId], references: [id], onDelete: Restrict)
  actor     User            @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actionId, createdAt, id])
}

model ActionCreateRequest {
  id             String      @id @default(uuid())
  actorId        String
  idempotencyKey String
  requestHash    String
  actionId       String      @unique
  createdAt      DateTime    @default(now())
  actor          User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action         ActionTaken @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@unique([actorId, idempotencyKey])
}

model TicketCreateRequest {
  id             String        @id @default(uuid())
  requesterId    String
  idempotencyKey String
  requestHash    String
  ticketId       String?       @unique
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  requester      User          @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  ticket         Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@unique([requesterId, idempotencyKey])
}

model Attachment {
  id                     String         @id @default(uuid())
  ticketId               String
  originalName           String
  storedName             String
  mimeType               String
  sizeBytes              Int
  storageKey             String
  uploadedByRequesterId  String
  uploadedAt             DateTime       @default(now())
  removedAt              DateTime?
  removalReason          String?
  removedByRequesterId   String?
  ticket                 Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedBy             User           @relation("AttachmentUploadedBy", fields: [uploadedByRequesterId], references: [id], onDelete: Restrict)
  removedBy              User?          @relation("AttachmentRemovedBy", fields: [removedByRequesterId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}
