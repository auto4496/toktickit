{
  "name": "toktickit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TokTickIT Lab 1 Initial Project Setup",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run server/tests/lab-02/reference-data.integration.test.ts",
    "test:watch": "vitest",
    "prisma:generate": "npx prisma generate --schema=server/prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=server/prisma/schema.prisma"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/supertest": "^6.0.2",
    "jsdom": "^29.1.1",
    "prisma": "^6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
